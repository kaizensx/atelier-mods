    {
      "id": "com.example.pomodoro",
      "name": "Pomodoro",
      "author": "Atelier Examples",
      "github": "kaizensx",
      "kind": "plugin",
      "version": "1.0.0",
      "summary": "A focus timer as a Dock tile, a widget, a command and a hot-corner action.",
      "description": "# Pomodoro\n\nTwenty-five minutes of focus, five of rest. Click the Dock tile to start or pause.\n\n- **Dock tile** with the time left, a progress ring and a badge for finished sessions.\n- **Widget** for the board, with the same ring.\n- **Command**: *Start or Pause Pomodoro* in the Command palette.\n- **Hot corner**: put *Pomodoro* on any corner in Hot Corners.\n\nA notification tells you when a session ends. That is the only permission it asks for.\n\nIt is also the reference plugin: every kind of registration in one short script. Read `main.js` to see how each one works.\n",
      "permissions": [
        "notifications"
      ],
      "hosts": [],
      "minAtelier": "1.0.0",
