    {
      "id": "com.example.github-notifications",
      "name": "GitHub Notifications",
      "author": "Atelier Examples",
      "github": "kaizensx",
      "kind": "plugin",
      "version": "1.0.1",
      "summary": "Your unread GitHub notifications as a widget and a Dock badge. Needs a personal access token with the notifications scope.",
      "description": "# GitHub Notifications\n\nUnread notifications from GitHub, on your desktop.\n\n1. Run **Set GitHub Token** from the Command palette.\n2. Paste a classic personal access token with the `notifications` scope. Make one at [github.com/settings/tokens](https://github.com/settings/tokens).\n3. Add a **Plugin** widget to the board and choose *GitHub*.\n\nThe token is kept in the plugin's own storage and sent only to `api.github.com`, the one host it may reach. Clicking the Dock tile opens your notifications in the browser.\n\n> Pull requests waiting for your review are drawn in orange.\n",
      "permissions": [
        "network",
        "openURL"
      ],
      "hosts": [
        "api.github.com"
      ],
      "minAtelier": "1.0.0",
      "homepage": "https://github.com/kaizensx/Atelier/tree/main/examples/plugins/github-notifications.atelierplugin",
      "license": "MIT",
      "tags": [
        "github",
        "developer",
        "notifications"
      ],
