{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atelier:collections:1",
  "title": "Atelier Mods collections",
  "description": "collections.json at the root of the catalog: shelves of mods curated by the maintainers, shown in Atelier's Browse and on the website.",
  "type": "object",
  "required": ["collections"],
  "additionalProperties": false,
  "patternProperties": { "^(\\$|x-)": {} },
  "properties": {
    "collections": {
      "type": "array", "maxItems": 24,
      "items": {
        "type": "object", "required": ["id", "title", "mods"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "maxLength": 60, "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "description": { "type": "string", "maxLength": 300 },
          "mods": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "type": "string", "maxLength": 120 } }
        }
      }
    }
  }
}
